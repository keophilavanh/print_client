{
  "name": "print-client",
  "version": "1.0.0",
  "private": true,
  "description": "TypeScript browser client for the print service",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "start": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning dist/server.js"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "@types/node": "^25.0.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.0"
  }
}
