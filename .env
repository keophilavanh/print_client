# Web UI port (3000-3003 are used by Docker containers; 3010 is the Windows print agent)
PORT=3020

# Print Service (Socket.IO)
PRINT_SERVICE_URL=https://printer.inthida.com

# SQLite storage folder
PRINT_CLIENT_DATA_DIR=./data

# Initial shop pairing code (a code saved from the UI takes priority)
PRINT_SHOP_CODE=

# Default Windows print agent for printers without their own agent URL.
# Not used when this service runs on Windows: those printers print straight to the \\host\share.
WINDOWS_PRINT_AGENT_URL=https://printer.inthida.com

# Job history
PRINT_HISTORY_LIMIT=1000
PRINT_LIST_LIMIT=300
PRINT_PRINTED_RETENTION_DAYS=7

# Printer health checks
PRINTER_CHECK_INTERVAL_MS=30000
PRINTER_CHECK_TIMEOUT_MS=3000
PRINTER_TIMEOUT_MS=10000

# Delivery and retries
PRINT_ACK_TIMEOUT_MS=10000
PRINT_RETRY_MAX_ATTEMPTS=10
PRINT_RETRY_BASE_DELAY_MS=10000
PRINT_RETRY_MAX_DELAY_MS=300000
